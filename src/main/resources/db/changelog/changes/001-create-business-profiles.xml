<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001" author="samson">
        <createTable tableName="business_profiles">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="business_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="business_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="location" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>

        <!-- Add at the bottom of changeSet 001, before </changeSet> -->
        <createIndex tableName="business_profiles"
                     indexName="idx_business_profiles_business_type">
            <column name="business_type"/>
        </createIndex>

        <createIndex tableName="business_profiles"
                     indexName="idx_business_profiles_location">
            <column name="location"/>
        </createIndex>

        <createIndex tableName="business_profiles"
                     indexName="idx_business_profiles_is_deleted">
            <column name="is_deleted"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>